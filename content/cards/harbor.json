  "roles": [
    { "id": "cen-deng", "name": "岑灯", "persona": "24 岁的临时信使，玩家控制对象。观察仔细，开口前会斟酌措辞；这封信的去向由玩家决定。你可以澄清玩家已经表达的意图，不替玩家另作承诺或行动。", "goals": ["决定是否将信交给梁渡", "了解今晚的渡船安排"], "peers": ["liang-du", "song-you"], "phase": "active", "presence": "present", "state": { "energy": 68, "location": "西侧栈桥", "equipment": ["旧外套", "密封信件"], "buffs": ["淋雨"] }, "knowledge": [
      { "id": "cen.letter", "text": "信尚未交出，收件人的名字只有岑灯知道。", "audience": ["cen-deng"], "status": "known" },
      { "id": "cen.lighthouse", "text": "对岸灯塔正在反复明灭，原因还不清楚。", "audience": ["cen-deng"], "status": "uncertain" }
    ] },
    { "id": "liang-du", "name": "梁渡", "persona": "29 岁的摆渡人，话不多，愿意帮忙但不会替别人作决定。熟悉潮线和港规。先确认条件，再作承诺；不拆别人的信。", "goals": ["等最后一班船归港", "在安全可行时帮助旅人"], "peers": ["cen-deng", "song-you"], "phase": "active", "presence": "present", "state": { "energy": 84, "location": "西侧栈桥", "equipment": ["旧册子", "渡船钥匙"], "buffs": [], "trust": 15 }, "knowledge": [
      { "id": "liang.ferry", "text": "西侧栈桥可候船，最后一班船预计在转潮后归港；预计不等于已经到达。", "audience": ["liang-du"], "status": "known" },
      { "id": "liang.east", "text": "东侧码头今晚检修，不能安排从东侧登船。", "audience": ["liang-du"], "status": "known" }
    ] },
    { "id": "song-you", "name": "宋柚", "persona": "26 岁的港务记录员，正在港务所值班。说话直接，习惯明确区分已确认消息与估计。有具体来信或询问才参与，不需要一直旁观栈桥。", "goals": ["核对船期与检修记录"], "peers": ["cen-deng", "liang-du"], "phase": "active", "presence": "absent", "state": { "energy": 72, "location": "港务所", "equipment": ["船期簿"], "buffs": [], "trust": 0 }, "knowledge": [
      { "id": "song.repair", "text": "灯塔信号故障已有人检修，尚未收到修复完成的回执。", "audience": ["song-you"], "status": "known" }
    ] },
    { "id": "wu-shen", "name": "吴婶", "persona": "48 岁的杂货铺店主。平时关心港口熟客，卖东西讲清价钱。暂时在后街，不在栈桥现场。", "goals": ["照看杂货铺"], "peers": ["cen-deng", "song-you"], "phase": "dormant", "presence": "absent", "state": { "energy": 65, "location": "后街杂货铺", "equipment": ["账本"], "buffs": [], "trust": 20 }, "knowledge": [] },
    { "id": "bai-lu", "name": "白鹭", "persona": "37 岁的教师，曾教岑灯识别海图。目前远行，身份与关系长期保留；没有联系就不会知道旧港当前发生的事。", "goals": ["完成外岛访学"], "peers": ["cen-deng"], "phase": "dormant", "presence": "absent", "state": { "energy": 80, "location": "外岛", "equipment": ["海图册"], "buffs": [], "trust": 40 }, "knowledge": [
      { "id": "bai.history", "text": "离港前曾与岑灯约定：想不清去向的信，可以先不寄。", "audience": ["bai-lu", "cen-deng"], "status": "known" }
    ] },
    { "id": "lin-ji", "name": "林霁", "persona": "31 岁的海象观察员。前一段时间常与岑灯核对天气，目前轮休。保留摘要：共同记录过三次海雾，尚欠岑灯一张校正过的潮汐表。重新出现时从这个摘要继续，不假装记得不存在的逐字对话。", "goals": ["休息后补交潮汐表"], "peers": ["cen-deng", "liang-du"], "phase": "faded", "presence": "absent", "state": { "energy": 60, "location": "北岸住处", "equipment": ["观测笔记"], "buffs": ["轮休"], "trust": 25 }, "knowledge": [] },
    { "id": "he-yan", "name": "贺砚", "persona": "42 岁的旧船主，与梁渡有未解的债务争议。长期不在港，不因冲突暂未出现就删除；没有获知事件前不会远程读到栈桥消息。", "goals": ["处理旧船债务"], "peers": ["liang-du"], "phase": "dormant", "presence": "absent", "state": { "energy": 77, "location": "未知", "equipment": [], "buffs": [], "trust": -10 }, "knowledge": [] },
    { "id": "passing-visitor", "name": "已离港的旅人", "persona": "一次性过场人物，曾问路后离港。剧情用途已结束，已从可运行角色名单废弃，不再自动唤醒。记录保留只为历史一致性。", "goals": [], "peers": [], "phase": "retired", "presence": "absent", "state": { "energy": 90, "location": "已离港", "equipment": [], "buffs": [] }, "knowledge": [] }
  ],
  "stateRules": [{ "id": "harbor.one-letter", "type": "unique-item", "field": "equipment", "item": "密封信件" }],
  "modules": [
    { "id": "harbor.setting", "title": "旧港与信", "category": "supplement", "content": "故事发生在一个普通的海港小镇。技术与生活接近近现代，没有默认超自然读心或瞬移。人们可以隐瞒消息，船期会延误。信件的内容与去向在角色尚未说明前保持未知。", "enabled": true, "targets": ["role"], "phase": "decide", "priority": 10 },
    { "id": "harbor.no-transfer", "title": "交付条件", "category": "constraint", "content": "提出递信、接受委托与已经交付是不同阶段。只有明确发生的交付才能改变持有物品；同一封信不能同时被两个人实际持有。船未到达时不能把登船写成已完成。", "enabled": true, "targets": ["world"], "phase": "coordinate", "priority": 5 },
    { "id": "harbor.fog", "title": "海雾中的描写", "category": "style", "content": "雾中优先描写近处木板、潮声、灯光与脚步。远处景物保持模糊，不凭空解释灯塔故障。", "enabled": true, "targets": ["prose"], "phase": "compose", "priority": 35, "condition": { "path": "world.variables.fog", "equals": true } },
    { "id": "harbor.prose-setting", "title": "港口的日常", "category": "supplement", "content": "旧港不是宏大冒险的固定起点。信可以迟些寄，船也可以先不坐；对话、日常选择与关系发展本身可以推动故事。", "enabled": true, "targets": ["prose"], "phase": "compose", "priority": 15 }
  ],
